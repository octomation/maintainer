#!/usr/bin/env bash

deactivate() {
  unset _OS
  unset _ARCH
  unset _ROOT
  unset _GOBINPATH

  if [[ -n "${_OLD_GO111MODULE+set}" ]]; then
    export GO111MODULE="${_OLD_GO111MODULE}"
    if [[ -z "${_OLD_GO111MODULE}" ]]; then
      unset GO111MODULE
    fi
    unset _OLD_GO111MODULE
  fi

  if [[ -n "${_OLD_GOBIN+set}" ]]; then
    export GOBIN="${_OLD_GOBIN}"
    if [[ -z "${_OLD_GOBIN}" ]]; then
      unset GOBIN
    fi
    unset _OLD_GOBIN
  fi

  if [[ -n "${_OLD_GOFLAGS+set}" ]]; then
    export GOFLAGS="${_OLD_GOFLAGS}"
    if [[ -z "${_OLD_GOFLAGS}" ]]; then
      unset GOFLAGS
    fi
    unset _OLD_GOFLAGS
  fi

  if [[ -n "${_OLD_GOPRIVATE+set}" ]]; then
    export GOPRIVATE="${_OLD_GOPRIVATE}"
    if [[ -z "${_OLD_GOPRIVATE}" ]]; then
      unset GOPRIVATE
    fi
    unset _OLD_GOPRIVATE
  fi

  if [[ -n "${_OLD_GOPROXY+set}" ]]; then
    export GOPROXY="${_OLD_GOPROXY}"
    if [[ -z "${_OLD_GOPROXY}" ]]; then
      unset GOPROXY
    fi
    unset _OLD_GOPROXY
  fi

  if [[ -n "${_OLD_PATH+set}" ]]; then
    export PATH="${_OLD_PATH}"
    unset _OLD_PATH
  fi

  if [[ -n "${_OLD_PS1+set}" ]]; then
    export PS1="${_OLD_PS1}"
    if [[ -z "${_OLD_PS1}" ]]; then
      unset PS1
    fi
    unset _OLD_PS1
  fi

  if [[ -n "${BASH:-}" || -n "${ZSH_VERSION:-}" ]]; then
    hash -r
  fi

  if [[ "${1:-}" != "nondestructive" ]]; then
    unset -f deactivate
    unset -f release
  fi
}

release() {
  local latest
  if ! latest=$(git describe --tags --abbrev=0 2>/dev/null); then
    echo >&2 'release: no tag to compare with'
    return 1
  fi
  gorelease -base="${latest}" -version="${1:-}"
}

deactivate nondestructive

_OLD_GO111MODULE="${GO111MODULE:-}"
_OLD_GOBIN="${GOBIN:-}"
_OLD_GOFLAGS="${GOFLAGS:-}"
_OLD_GOPRIVATE="${GOPRIVATE:-}"
_OLD_GOPROXY="${GOPROXY:-}"

_OS=$(uname -s | tr '[:upper:]' '[:lower:]')
_ARCH=$(uname -m | tr '[:upper:]' '[:lower:]')
_ROOT=$(dirname "$(dirname "$(realpath "${BASH_SOURCE[0]:-$0}")")")
_GOBINPATH="${_ROOT}/bin/${_OS}/${_ARCH}"
_OLD_PATH="${PATH:-}"

export GO111MODULE=on
export GOBIN="${_GOBINPATH}"
export GOFLAGS=-mod=
export GOPRIVATE=go.octolab.org
export GOPROXY=https://proxy.golang.org,direct
export PATH="${_GOBINPATH}:${PATH}"

_OLD_PS1="${PS1:-}"
export PS1="(activated) ${PS1:-}"

if [[ -n "${BASH:-}" || -n "${ZSH_VERSION:-}" ]]; then
  hash -r
fi
