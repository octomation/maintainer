{
  "x-release": {
    "tag_pattern": "^v\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$",
    "notes": "docs/content/changelog/{tag}.md",
    "branches": []
  },
  "secrets": {
    "OCTOLAB_RELEASER_CLIENT_ID": { "scope": "organization" },
    "OCTOLAB_RELEASER_KEY": { "scope": "organization" }
  },
  "pages": {
    "cname": "maintainer.octolab.org",
    "https_enforced": true,
    "build_type": "workflow"
  },
  "workflows": {
    "cleanup.stale.yml": {
      "state": "disabled_manually",
      "reason": "off until the open issues and PRs to keep have an assignee, a milestone or status: pending"
    }
  }
}
